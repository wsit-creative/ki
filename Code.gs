const S={P:'Products',V:'VoucherRules',O:'Orders',A:'AuditLog',COOLDOWN:86400000};
function doGet(e){
  if(e && e.parameter && e.parameter.bridge==='1'){
    const origin=required('GITHUB_PAGES_ORIGIN');
    if(!/^https:\/\/[a-z0-9.-]+(?::\d+)?$/i.test(origin)) throw Error('GITHUB_PAGES_ORIGIN harus origin HTTPS tanpa path, contoh https://username.github.io');
    const t=HtmlService.createTemplateFromFile('Bridge');
    t.allowedOrigin=origin;
    return t.evaluate().setTitle('Order Subsidi API Bridge').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  }
  return HtmlService.createHtmlOutput('Backend Order Barang Subsidi aktif. Buka halaman toko melalui GitHub Pages.').setTitle('Backend Order Barang Subsidi');
}
function setupSheets(){const ss=SpreadsheetApp.getActiveSpreadsheet();[['Products',['product_id','sku','name','stock','expiry_date','description','image_url','active','created_at','updated_at']],['VoucherRules',['rule_id','nik_hmac','product_id','interval_days','status','created_at','created_by','updated_at']],['Orders',['order_id','nik_hmac','product_id','product_name','quantity','order_status','created_at','picked_up_at','picked_up_by','customer_name','customer_phone','note','updated_at','customer_address','cart_group_id']],['AuditLog',['timestamp','actor','action','result','reference']]].forEach(x=>{let sh=ss.getSheetByName(x[0]);if(!sh)sh=ss.insertSheet(x[0]);if(sh.getLastRow()===0){sh.appendRow(x[1]);sh.setFrozenRows(1);sh.getRange(1,1,1,x[1].length).setFontWeight('bold')}else{let old=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),1)).getDisplayValues()[0].filter((v,i,a)=>i<x[1].length);let prefixOk=old.every((v,i)=>v===x[1][i]);if(!prefixOk||old.length>x[1].length)throw Error('Header sheet '+x[0]+' tidak sesuai.');if(old.length<x[1].length){sh.getRange(1,old.length+1,1,x[1].length-old.length).setValues([x[1].slice(old.length)]);sh.getRange(1,old.length+1,1,x[1].length-old.length).setFontWeight('bold');}}});return{ok:true,message:'Sheet siap'};}
function api(action,p){p=p||{};try{switch(action){case'publicProducts':return publicProducts();case'checkVoucher':return checkVoucher(p);case'createOrder':return createOrder(p);case'adminLogin':return adminLogin(p);case'adminLogout':return adminLogout(p);case'adminProducts':admin(p.token);return adminProducts();case'saveProduct':admin(p.token);return saveProduct(p);case'setProductActive':admin(p.token);return setProductActive(p);case'adminVoucherRules':admin(p.token);return adminVoucherRules();case'saveVoucherRule':admin(p.token);return saveVoucherRule(p);case'setVoucherStatus':admin(p.token);return setVoucherStatus(p);case'adminOrders':admin(p.token);return adminOrders();case'updateOrderStatus':admin(p.token);return updateOrderStatus(p);case'confirmPickup':admin(p.token);return confirmPickup(p);case'cancelOrder':admin(p.token);return cancelOrder(p);default:return{ok:false,message:'Aksi tidak dikenal'};}}catch(e){console.error(e.stack||e);let m=String(e.message||'');if(m==='UNAUTHORIZED')m='Sesi admin habis. Login lagi.';if(m==='NIK_FORMAT')m='NIK harus 16 digit angka.';return{ok:false,message:m.length<180?m:'Kesalahan server. Periksa konfigurasi.'};}}
function publicProducts(){const r=sheet(S.P).getDataRange().getValues(),out=[],today=dateOnly(new Date());for(let i=1;i<r.length;i++){let x=r[i];if(!x[0]||!truth(x[7])||Number(x[3])<=0)continue;let ex=dateOnly(x[4]);if(ex&&ex<today)continue;out.push({productId:String(x[0]),sku:String(x[1]),name:String(x[2]),stock:Number(x[3]),expiryDate:ex,description:String(x[5]||''),imageUrl:safeImage(x[6])});}return{ok:true,products:out};}
function adminProducts(){const r=sheet(S.P).getDataRange().getValues(),out=[];for(let i=1;i<r.length;i++){let x=r[i];if(x[0])out.push({productId:String(x[0]),sku:String(x[1]),name:String(x[2]),stock:Number(x[3]),expiryDate:dateOnly(x[4]),description:String(x[5]||''),imageUrl:safeImage(x[6]),active:truth(x[7])});}return{ok:true,products:out};}
function saveProduct(p){let sku=text(p.sku,40),name=text(p.name,120),stock=Number(p.stock),exp=String(p.expiryDate||''),desc=text(p.description,500),img=safeImage(p.imageUrl);if(!sku||!name)return{ok:false,message:'SKU dan nama wajib diisi.'};if(!Number.isInteger(stock)||stock<0||stock>1e7)return{ok:false,message:'Stok harus angka bulat 0 atau lebih.'};if(exp&&!/^\d{4}-\d{2}-\d{2}$/.test(exp))return{ok:false,message:'Tanggal expired tidak valid.'};let l=LockService.getScriptLock();l.waitLock(10000);try{let sh=sheet(S.P),r=sh.getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][1]).toLowerCase()===sku.toLowerCase())return{ok:false,message:'SKU sudah digunakan.'};let id=Utilities.getUuid(),now=new Date();sh.appendRow([id,sku,name,stock,exp,desc,img,true,now,now]);audit('admin','product_create','success',id);return{ok:true,message:'Barang berhasil ditambahkan.'};}finally{l.releaseLock();}}
function setProductActive(p){let r=sheet(S.P).getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][0])===String(p.productId)){sheet(S.P).getRange(i+1,8).setValue(p.active===true);sheet(S.P).getRange(i+1,10).setValue(new Date());return{ok:true,message:'Status barang diperbarui.'};}return{ok:false,message:'Barang tidak ditemukan.'};}
function saveVoucherRule(p){let nik=normNik(p.nik),pid=String(p.productId||''),days=Number(p.intervalDays);if(!pid||!findProduct(pid))return{ok:false,message:'Pilih barang yang valid.'};if(!Number.isInteger(days)||days<1||days>3650)return{ok:false,message:'Jangka waktu harus 1–3650 hari.'};let h=hmac(nik,required('NIK_HMAC_KEY')),l=LockService.getScriptLock();l.waitLock(10000);try{let sh=sheet(S.V),r=sh.getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][1])===h&&String(r[i][2])===pid&&String(r[i][4])==='active')return{ok:false,message:'NIK sudah punya aturan aktif untuk barang ini.'};let id=Utilities.getUuid(),now=new Date();sh.appendRow([id,h,pid,days,'active',now,'admin',now]);audit('admin','voucher_add','success',id);return{ok:true,message:'Promo tersimpan. NIK asli tidak disimpan.'};}finally{l.releaseLock();}}
function adminVoucherRules(){let v=sheet(S.V).getDataRange().getValues(),p=sheet(S.P).getDataRange().getValues(),names={};for(let i=1;i<p.length;i++)names[String(p[i][0])]=String(p[i][2]);let out=[];for(let i=1;i<v.length;i++)if(v[i][0])out.push({ruleId:String(v[i][0]),nikHint:'••••••••••••'+String(v[i][1]).slice(-4),productId:String(v[i][2]),productName:names[String(v[i][2])]||'(barang tidak ditemukan)',intervalDays:Number(v[i][3]),status:String(v[i][4])});return{ok:true,rules:out};}
function setVoucherStatus(p){let r=sheet(S.V).getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][0])===String(p.ruleId)&&['active','inactive'].includes(p.status)){sheet(S.V).getRange(i+1,5).setValue(p.status);sheet(S.V).getRange(i+1,8).setValue(new Date());return{ok:true,message:'Status promo diperbarui.'};}return{ok:false,message:'Aturan promo tidak ditemukan atau status tidak valid.'};}
function checkVoucher(p){let nik=normNik(p.nik),pid=String(p.productId||''),h=hmac(nik,required('NIK_HMAC_KEY')),rule=findRule(h,pid);if(!rule)return{ok:true,eligible:false,message:'NIK tidak terdaftar untuk barang ini atau promo tidak aktif.'};let cd=cooldown(h,pid,rule.days);return cd.allowed?{ok:true,eligible:true,message:'NIK valid untuk barang ini.'}:{ok:true,eligible:false,availableAt:cd.at,message:'NIK belum bisa digunakan untuk barang ini. Coba setelah '+fmt(cd.at)+'.'};}
function createOrder(p){let name=text(p.customerName,100),phone=text(p.customerPhone,40),address=text(p.customerAddress,1000),note=text(p.note,300),nikRaw=String(p.nik||'').replace(/\s+/g,'');let items=Array.isArray(p.items)?p.items.map(x=>({productId:String(x.productId||''),quantity:Number(x.quantity)})):[{productId:String(p.productId||''),quantity:Number(p.quantity||1)}];items=items.filter(x=>x.productId);let merged={};items.forEach(x=>{merged[x.productId]=(merged[x.productId]||0)+x.quantity});items=Object.keys(merged).map(productId=>({productId,quantity:merged[productId]}));if(!name||!phone||!address||!items.length||items.length>20||items.some(x=>!Number.isInteger(x.quantity)||x.quantity<1||x.quantity>50))return{ok:false,message:'Lengkapi nama, nomor WhatsApp, alamat, dan jumlah barang (1–50 per barang; maksimal 20 jenis).'};let nik='';if(nikRaw){try{nik=normNik(nikRaw)}catch(e){return{ok:false,message:'Voucher/NIK harus 16 digit angka, atau kosongkan jika tidak punya.'}}}let l=LockService.getScriptLock();l.waitLock(10000);try{let prepared=[],today=dateOnly(new Date());for(let item of items){let prod=findProduct(item.productId);if(!prod||!prod.active)return{ok:false,message:'Salah satu barang tidak tersedia.'};if(prod.expiryDate&&prod.expiryDate<today)return{ok:false,message:'Barang '+prod.name+' melewati tanggal expired.'};if(prod.stock<item.quantity)return{ok:false,message:'Stok '+prod.name+' tidak mencukupi.'};let h='',rule=null;if(hasActiveVoucherRules(item.productId)&&!nik)return{ok:false,message:'Barang '+prod.name+' wajib menggunakan voucher/NIK.'};if(nik){let candidateH=hmac(nik,required('NIK_HMAC_KEY'));rule=findRule(candidateH,item.productId);if(rule)h=candidateH;}if(hasActiveVoucherRules(item.productId)&&!rule)return{ok:false,message:'Voucher/NIK yang dimasukkan tidak terdaftar untuk barang '+prod.name+'.'};if(rule){let cd=cooldown(h,item.productId,rule.days);if(!cd.allowed)return{ok:false,message:'NIK belum bisa digunakan untuk '+prod.name+' sampai '+fmt(cd.at)+'.'};}prepared.push({prod,quantity:item.quantity,h});}let now=new Date(),group=Utilities.getUuid(),ids=[];prepared.forEach(x=>{setStock(x.prod.productId,x.prod.stock-x.quantity);let id=Utilities.getUuid();ids.push(id);sheet(S.O).appendRow([id,x.h,x.prod.productId,x.prod.name,x.quantity,'pending',now,'','',''+name,''+phone,note,now,address,group]);});audit('customer','order_create','success',group);return{ok:true,orderId:ids[0],orderIds:ids,cartGroupId:group,message:'Pesanan berhasil disimpan. Masa tunggu voucher mulai setelah barang selesai diambil.'};}finally{l.releaseLock();}}
function hasActiveVoucherRules(pid){let r=sheet(S.V).getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][2])===String(pid)&&String(r[i][4])==='active')return true;return false;}
function adminOrders(){let r=sheet(S.O).getDataRange().getValues(),out=[];for(let i=r.length-1;i>=1;i--){let x=r[i];if(x[0])out.push({orderId:String(x[0]),productName:String(x[3]),quantity:Number(x[4]),status:String(x[5]),createdAt:x[6]?new Date(x[6]).toISOString():'',pickedUpAt:x[7]?new Date(x[7]).toISOString():'',customerName:String(x[9]||''),customerPhone:String(x[10]||''),note:String(x[11]||''),customerAddress:String(x[13]||''),cartGroupId:String(x[14]||'')});}return{ok:true,orders:out};}
function updateOrderStatus(p){if(p.status==='cancelled')return cancelOrder(p);if(p.status!=='paid')return{ok:false,message:'Status tidak valid.'};let l=LockService.getScriptLock();l.waitLock(10000);try{let r=sheet(S.O).getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][0])===String(p.orderId)){if(String(r[i][5])!=='pending')return{ok:false,message:'Hanya pesanan pending yang bisa ditandai dibayar.'};sheet(S.O).getRange(i+1,6).setValue('paid');sheet(S.O).getRange(i+1,13).setValue(new Date());return{ok:true,message:'Status menjadi paid.'};}return{ok:false,message:'Pesanan tidak ditemukan.'};}finally{l.releaseLock();}}
function confirmPickup(p){let l=LockService.getScriptLock();l.waitLock(10000);try{let sh=sheet(S.O),r=sh.getDataRange().getValues(),row=-1,h='',pid='',st='';for(let i=1;i<r.length;i++)if(String(r[i][0])===String(p.orderId)){row=i+1;h=String(r[i][1]||'');pid=String(r[i][2]);st=String(r[i][5]);break;}if(row<0)return{ok:false,message:'Pesanan tidak ditemukan.'};if(st==='completed')return{ok:false,message:'Pesanan sudah selesai diambil.'};if(!['pending','paid'].includes(st))return{ok:false,message:'Status pesanan tidak bisa dikonfirmasi.'};if(h){let rule=findRule(h,pid);if(rule){let cd=cooldown(h,pid,rule.days);if(!cd.allowed)return{ok:false,message:'Pengambilan ditolak; NIK masih dalam masa tunggu sampai '+fmt(cd.at)+'.'};}}let now=new Date();sh.getRange(row,6).setValue('completed');sh.getRange(row,8).setValue(now);sh.getRange(row,9).setValue('admin');sh.getRange(row,13).setValue(now);audit('admin','pickup','success',String(p.orderId));return{ok:true,message:'Pengambilan dicatat. Masa tunggu voucher dimulai sekarang jika pesanan memakai voucher.'};}finally{l.releaseLock();}}
function cancelOrder(p){let l=LockService.getScriptLock();l.waitLock(10000);try{let sh=sheet(S.O),r=sh.getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][0])===String(p.orderId)){if(!['pending','paid'].includes(String(r[i][5])))return{ok:false,message:'Pesanan tidak dapat dibatalkan.'};let prod=findProduct(String(r[i][2]));if(prod)setStock(prod.productId,prod.stock+(Number(r[i][4])||0));sh.getRange(i+1,6).setValue('cancelled');sh.getRange(i+1,13).setValue(new Date());audit('admin','cancel','success',String(p.orderId));return{ok:true,message:'Pesanan dibatalkan, stok dikembalikan.'};}return{ok:false,message:'Pesanan tidak ditemukan.'};}finally{l.releaseLock();}}
function adminLogin(p){let pass=String(p.password||''),props=PropertiesService.getScriptProperties(),key=props.getProperty('ADMIN_AUTH_KEY'),expected=props.getProperty('ADMIN_PASSWORD_HMAC');if(!pass||!key||!expected)return{ok:false,message:'Login gagal atau konfigurasi admin belum lengkap.'};if(!eq(hmac(pass,key),expected)){audit('anonymous','login','denied','');Utilities.sleep(500);return{ok:false,message:'Login gagal.'};}let token=Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');CacheService.getScriptCache().put('admin:'+sha(token),'admin',21600);audit('admin','login','success','');return{ok:true,token:token};}
function adminLogout(p){if(p.token)CacheService.getScriptCache().remove('admin:'+sha(String(p.token)));return{ok:true};}
function admin(token){if(!token||CacheService.getScriptCache().get('admin:'+sha(String(token)))!=='admin')throw Error('UNAUTHORIZED');}
function findRule(h,pid){let r=sheet(S.V).getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][1])===h&&String(r[i][2])===pid&&String(r[i][4])==='active')return{id:String(r[i][0]),days:Number(r[i][3])||7};return null;}
function cooldown(h,pid,days){let r=sheet(S.O).getDataRange().getValues(),latest=0;for(let i=1;i<r.length;i++)if(String(r[i][1])===h&&String(r[i][2])===pid&&String(r[i][5])==='completed'&&r[i][7]){let t=new Date(r[i][7]).getTime();if(Number.isFinite(t)&&t>latest)latest=t;}if(!latest)return{allowed:true};let at=new Date(latest+Math.max(1,days||7)*S.COOLDOWN);return Date.now()>=at.getTime()?{allowed:true}:{allowed:false,at:at.toISOString()};}
function findProduct(id){let r=sheet(S.P).getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][0])===id)return{id:String(r[i][0]),sku:String(r[i][1]),name:String(r[i][2]),stock:Number(r[i][3])||0,expiryDate:dateOnly(r[i][4]),description:String(r[i][5]||''),imageUrl:safeImage(r[i][6]),active:truth(r[i][7]),row:i+1};return null;}
function setStock(id,n){let p=findProduct(id);if(!p)throw Error('Barang tidak ditemukan.');sheet(S.P).getRange(p.row,4).setValue(n);sheet(S.P).getRange(p.row,10).setValue(new Date());}
function normNik(v){let n=String(v||'').replace(/\s+/g,'');if(!/^\d{16}$/.test(n))throw Error('NIK_FORMAT');return n;}
function hmac(m,k){return Utilities.computeHmacSha256Signature(String(m),String(k),Utilities.Charset.UTF_8).map(b=>{let v=(b<0?b+256:b).toString(16);return v.length===1?'0'+v:v;}).join('');}
function sha(v){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(v),Utilities.Charset.UTF_8).map(b=>{let n=(b<0?b+256:b).toString(16);return n.length===1?'0'+n:n;}).join('');}
function eq(a,b){a=String(a);b=String(b);if(a.length!==b.length)return false;let d=0;for(let i=0;i<a.length;i++)d|=a.charCodeAt(i)^b.charCodeAt(i);return d===0;}
function required(k){let v=PropertiesService.getScriptProperties().getProperty(k);if(!v)throw Error('Script Properties '+k+' belum diatur. Baca README.');return v;}
function sheet(n){let s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(n);if(!s)throw Error('Sheet '+n+' belum dibuat. Jalankan setupSheets().');return s;}
function text(v,max){return String(v==null?'':v).replace(/[<>]/g,'').trim().slice(0,max);}
function safeImage(v){let s=String(v||'').trim();if(!s)return'';if(s.length>1000||!/^https:\/\/[^\s"'<>]+$/i.test(s))throw Error('Link gambar harus URL HTTPS yang valid.');return s;}
function truth(v){return v===true||String(v)==='TRUE';}
function dateOnly(v){if(!v)return'';if(Object.prototype.toString.call(v)==='[object Date]'&&!isNaN(v))return Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd');let s=String(v).slice(0,10);return /^\d{4}-\d{2}-\d{2}$/.test(s)?s:'';}
function fmt(v){return Utilities.formatDate(new Date(v),Session.getScriptTimeZone(),'dd MMM yyyy HH:mm');}
function audit(actor,action,result,ref){try{sheet(S.A).appendRow([new Date(),actor,action,result,ref||'']);}catch(e){console.error('Audit failed');}}
function oneTimeSetAdminPasswordHmac(){const password='GANTI_DENGAN_PASSWORD_ADMIN_KUAT';const key=PropertiesService.getScriptProperties().getProperty('ADMIN_AUTH_KEY');if(!key)throw Error('Set ADMIN_AUTH_KEY dulu.');if(password==='GANTI_DENGAN_PASSWORD_ADMIN_KUAT'||password.length<14)throw Error('Ganti password contoh minimal 14 karakter lalu jalankan lagi.');PropertiesService.getScriptProperties().setProperty('ADMIN_PASSWORD_HMAC',hmac(password,key));}
